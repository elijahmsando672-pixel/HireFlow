PORT=3000
NODE_ENV=development

# JWT — must be a unique secret in production
JWT_SECRET=hireflow-local-development-secret

# Admin access — optional, matches by email if set
ADMIN_EMAIL=admin@hireflow.app

# Logging
LOG_LEVEL=info

# Job aggregation
AGGREGATION_ENABLED=true
RUN_SYNC_ON_START=false
JOB_SYNC_INTERVAL_MINUTES=30

# Mock source (development only — no external sites contacted)
MOCK_SOURCE_ENABLED=true
MOCK_SOURCE_FAIL_RATE=0

# Adzuna API credentials
ADZUNA_ENABLED=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
ADZUNA_RESULTS_PER_PAGE=20
ADZUNA_MAX_PAGES=2
ADZUNA_SEARCH_TERMS=software developer,web developer,javascript developer,python developer

# Example RSS source — disabled until a real authorized feed is configured
# EXAMPLE_RSS_FEED_URL=https://example.com/feed.xml
# EXAMPLE_RSS_ENABLED=false

# CORS — comma-separated allowed origins for production frontend
# CORS_ORIGIN=https://hireflow.app,https://www.hireflow.app

# Subscription paywall
SUBSCRIPTION_ENABLED=true
PAYWALL_ENABLED=true
SUBSCRIPTION_PROVIDER=mock
SUBSCRIPTION_PRO_PLAN=PRO
SUBSCRIPTION_PRICE_KES=500
SUBSCRIPTION_CURRENCY=KES
SUBSCRIPTION_DURATION_DAYS=30
# Redirect target after a PesaPal payment callback
FRONTEND_URL=http://localhost:5173

# PesaPal payment gateway
# mode=mock simulates payments (no credentials needed). Use "live" in production.
PESAPAL_MODE=mock
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Sandbox API (default). Switch to https://pay.pesapal.com/v3/api for live.
# PESAPAL_BASE_URL=https://pay.pesapal.com/v3/api
PESAPAL_IPN_URL=
PESAPAL_CALLBACK_URL=
