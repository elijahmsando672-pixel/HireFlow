PORT=3000
NODE_ENV=development

# JWT — must be a unique secret in production
JWT_SECRET=hireflow-local-development-secret

# Admin access — optional, matches by email if set
ADMIN_EMAIL=admin@hireflow.app

# Logging
LOG_LEVEL=info

# Job aggregation
AGGREGATION_ENABLED=true
RUN_SYNC_ON_START=false
JOB_SYNC_INTERVAL_MINUTES=30

# Mock source (development only — no external sites contacted)
MOCK_SOURCE_ENABLED=true
MOCK_SOURCE_FAIL_RATE=0

# Example RSS source — disabled until a real authorized feed is configured
# EXAMPLE_RSS_FEED_URL=https://example.com/feed.xml
# EXAMPLE_RSS_ENABLED=false

# CORS — comma-separated allowed origins for production frontend
# CORS_ORIGIN=https://hireflow.app,https://www.hireflow.app
